# =============================================================================
# Trading Bot: environment template (v0.4)
# -----------------------------------------------------------------------------
# PLACEHOLDERS ONLY. Never commit a real .env file.
#   cp config/.env.example .env   (then fill in values locally or from the vault)
# In paper/live deployments these values are injected from the secrets vault
# (VAULT_*), never stored on disk. Use trade-only API keys with
# withdrawals/transfers DISABLED wherever the platform allows it.
# =============================================================================

# ---- Global ------------------------------------------------------------------
APP_ENV=dev                      # dev | paper | live
TRADING_MODE=paper               # paper | live   (paper is the default; live needs policy + step-up auth)
LIVE_ENABLED=false               # hard switch; must be true AND risk_policy.autonomy allows live
BASE_CURRENCY=CAD
TZ=America/Toronto
LOG_LEVEL=INFO

# ---- Alpaca (US equities/ETFs) ---------------------------------------------------
# Paper:  https://paper-api.alpaca.markets   Live: https://api.alpaca.markets
# NOTE: Alpaca live accounts are not currently open to Canadian residents (see PLATFORMS.md)
ALPACA_API_KEY_ID=<your-alpaca-key-id>
ALPACA_API_SECRET_KEY=<your-alpaca-secret-key>
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex             # iex (free) | sip (paid subscription)

# ---- Interactive Brokers (global equities, FX, options, futures) -------------------
# TWS API ports: TWS paper 7497 / live 7496; IB Gateway paper 4002 / live 4001
IBKR_ACCOUNT_ID=<your-ibkr-account-id>       # paper accounts usually start with "DU"
IBKR_GATEWAY_HOST=127.0.0.1
IBKR_GATEWAY_PORT=4002
IBKR_CLIENT_ID=17                            # unique integer per API client connection
IBKR_READ_ONLY=true                          # flip to false only for trading environments

# ---- Coinbase Advanced Trade (crypto) ------------------------------------------------
# CDP API key (ECDSA/ES256). Key name format: organizations/<org_id>/apiKeys/<key_id>
COINBASE_API_KEY_NAME=organizations/<org-id>/apiKeys/<key-id>
COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n<placeholder>\n-----END EC PRIVATE KEY-----\n"
COINBASE_BASE_URL=https://api.coinbase.com/api/v3/brokerage

# ---- Kraken (crypto) -----------------------------------------------------------------
KRAKEN_API_KEY=<your-kraken-api-key>
KRAKEN_API_SECRET=<your-kraken-api-secret-base64>
KRAKEN_BASE_URL=https://api.kraken.com

# ---- Robinhood Crypto (US only; likely unavailable in Ontario; disabled by default)
ROBINHOOD_CRYPTO_API_KEY=<placeholder-us-only>
ROBINHOOD_CRYPTO_PRIVATE_KEY_B64=<placeholder-ed25519-private-key-base64>

# ---- OANDA (optional FX broker/data; IBKR is the primary FX venue) -------------------
OANDA_API_TOKEN=<your-oanda-api-token>
OANDA_ACCOUNT_ID=<xxx-xxx-xxxxxxx-xxx>
OANDA_ENV=practice               # practice | live
# practice: https://api-fxpractice.oanda.com   live: https://api-fxtrade.oanda.com

# ---- Market data / news / fundamentals -----------------------------------------------
POLYGON_API_KEY=<your-polygon-massive-api-key>   # Polygon.io is now Massive (api.massive.com; api.polygon.io still works)
POLYGON_BASE_URL=https://api.massive.com
FINNHUB_API_KEY=<your-finnhub-api-key>
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ---- LLM news screener (pluggable provider) ---------------------------------------------
LLM_SCREENER_PROVIDER=<provider-name>
LLM_SCREENER_API_KEY=<your-llm-api-key>
LLM_SCREENER_MODEL=<pinned-model-id>
LLM_SCREENER_TIMEOUT_MS=2000

# ---- Database: Postgres + TimescaleDB ------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradingbot
POSTGRES_USER=tradingbot
POSTGRES_PASSWORD=<change-me>
DATABASE_URL=postgresql+asyncpg://tradingbot:<change-me>@localhost:5432/tradingbot
POSTGRES_SSLMODE=prefer          # require in paper/live

# ---- Redis ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=<change-me>
REDIS_TLS=false                  # true in paper/live

# ---- Secrets vault ---------------------------------------------------------------------
VAULT_PROVIDER=hashicorp         # hashicorp | aws-secrets-manager | 1password
VAULT_ADDR=https://vault.example.internal:8200
VAULT_ROLE_ID=<approle-role-id>
VAULT_SECRET_ID=<approle-secret-id>
VAULT_SECRET_PATH=kv/tradingbot/${APP_ENV}

# ---- MCP server / dashboard auth ---------------------------------------------------------
MCP_SERVER_URL=https://localhost:8443/mcp
OAUTH_ISSUER_URL=https://auth.example.com/
OAUTH_CLIENT_ID=<oauth-client-id>
OAUTH_CLIENT_SECRET=<oauth-client-secret>
OAUTH_AUDIENCE=tradingbot-mcp
DASHBOARD_SESSION_SECRET=<random-64-bytes>

# ---- Alerting / reporting ------------------------------------------------------------------
ALERT_EMAIL_TO=<owner@example.com>
ALERT_EMAIL_FROM=<bot@example.com>
SMTP_HOST=<smtp.example.com>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
PUSH_PROVIDER=ntfy               # ntfy | pushover | none
PUSH_TOPIC_OR_TOKEN=<placeholder>
ALERT_WEBHOOK_URL=<https://hooks.example.com/placeholder>
DAILY_SUMMARY_TIME=17:30         # America/Toronto

# ---- Watchdog ------------------------------------------------------------------------
WATCHDOG_HEARTBEAT_INTERVAL_S=5
WATCHDOG_MISSED_BEATS_TO_HALT=3
WATCHDOG_DEADMAN_TIMEOUT_S=60

# ---- Observability -----------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=<optional-sentry-dsn>

# ---- tradingbot-app additions (paper-only build) -------------------------------------
MCP_AUTH_TOKEN=<random-32+-char-token>    # required by tradingbot-mcp; placeholder is rejected
TRADINGBOT_STATE_DB=var/state.sqlite      # persisted kill switch / session state
TRADINGBOT_AUDIT_DB=var/audit.sqlite
DASHBOARD_PORT=8765                       # optional: serve local dashboard (127.0.0.1 only) from tradingbot-mcp
DASHBOARD_TOKEN=<random-32+-char-token>   # required for the dashboard kill button
TRADINGBOT_MCP_TOKENS=var/mcp_tokens.json # scoped MCP tokens (hashes only), create with tradingbot-owner mcp-token

# ---- Optional news screener providers (DISABLED by default; offline stub is used) ----
TRADINGBOT_LLM_ENABLED=false     # true + risk_policy llm_screener.provider: http_llm to use an LLM endpoint
TRADINGBOT_LLM_ENDPOINT=https://<your-llm-endpoint>/v1/chat/completions
TRADINGBOT_LLM_MODEL=<model-name>
TRADINGBOT_LLM_API_KEY=<your-llm-api-key>
TRADINGBOT_FINBERT_PATH=         # local directory of a FinBERT model (never downloaded)
