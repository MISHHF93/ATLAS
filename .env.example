# =============================================================================
# ATLAS environment template. PAPER TRADING ONLY. Copy to .env (gitignored) and fill in locally.
# Never commit real values. Every key is optional: a missing key shows "not configured" and that
# integration stays off. After adding a key, restart the server, then run:
#     python scripts/check_integrations.py
# Guide: docs/setup/integrations.md
# =============================================================================

# --- Alpaca: paper trading + market data (free) ------------------------------
# Paper key ID from https://app.alpaca.markets (switch to the Paper account first).
ALPACA_API_KEY_ID=
# Paper secret key (shown once when you generate the key).
ALPACA_API_SECRET_KEY=
# Paper endpoint. Any other URL (incl. live api.alpaca.markets) is refused by ATLAS.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market data feed: iex (free) or sip (paid subscription).
ALPACA_DATA_FEED=iex

# --- SEC EDGAR: fundamentals/filings (free, no key) ---------------------------
# Required User-Agent "AppName your-email@domain", e.g. ATLASResearch you@example.com
ATLAS_SEC_USER_AGENT=

# --- FRED / ALFRED: macro series + vintages (free key) ------------------------
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Market data feeds (all optional) -----------------------------------------
# Massive (formerly Polygon.io), free tier 5 calls/min.
POLYGON_API_KEY=
# Massive REST base URL.
POLYGON_BASE_URL=https://api.massive.com
# Same Massive key, used only by the optional Massive MCP server.
MASSIVE_API_KEY=
# Finnhub quotes/news/fundamentals, free tier.
FINNHUB_API_KEY=
# Tiingo EOD + IEX intraday, free tier.
TIINGO_API_KEY=
# Twelve Data, free tier.
TWELVEDATA_API_KEY=
# Alpha Vantage, free tier (25 calls/day).
ALPHAVANTAGE_API_KEY=
# Financial Modeling Prep fundamentals, free tier.
FMP_API_KEY=
# EODHD TSX/TSXV end-of-day (paid; free plan 20 calls/day).
EODHD_API_KEY=
# Databento tick data (PAID, billed per use).
DATABENTO_API_KEY=
# Databento dataset, e.g. GLBX.MDP3. Explicit opt-in because usage is billed.
ATLAS_DATABENTO_DATASET=
# OANDA FX data token (free practice account).
OANDA_API_TOKEN=
# OANDA practice account ID.
OANDA_ACCOUNT_ID=
# practice only (live is refused).
OANDA_ENV=practice
# Tradier data token (free sandbox account).
TRADIER_ACCESS_TOKEN=
# sandbox only (production is refused).
TRADIER_ENV=sandbox
# Questrade refresh token (single use, expires in 7 days).
QUESTRADE_REFRESH_TOKEN=
# Local IBKR Client Portal gateway URL, e.g. https://localhost:5000 (paper login).
IBKR_CP_GATEWAY_URL=
# Override keyless Binance REST hosts (comma separated). Blank = defaults.
ATLAS_BINANCE_REST_HOSTS=

# --- Alerts (free; OFF by default) --------------------------------------------
# Master switch. Nothing is sent unless this is true AND a channel is set.
ATLAS_ALERTS_ENABLED=false
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Telegram chat ID to post into.
TELEGRAM_CHAT_ID=
# Discord channel webhook URL.
DISCORD_WEBHOOK_URL=
# Slack incoming-webhook URL.
SLACK_WEBHOOK_URL=

# --- External data MCP servers (OFF by default; read-only tools only) ---------
# Set to on to allow the external MCP clients.
ATLAS_EXTERNAL_MCP=
# TradingView MCP token.
TRADINGVIEW_TOKEN=
# QuantConnect API token.
QUANTCONNECT_API_TOKEN=

# --- AI assistants (optional, paid) -------------------------------------------
# Google Gemini API key.
GEMINI_API_KEY=
# Gemini model ids. Tier must be paid (the free tier is used to improve Google products).
ATLAS_GEMINI_MODEL=gemini-3.8-flash
ATLAS_GEMINI_DEEP_MODEL=gemini-4-argon
ATLAS_GEMINI_TIER=paid
# Other assistant providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- Local paths / data use (optional, non-secret; uncomment to override) ----------------------------
# Operator-reviewed market-data use evidence (path to a private JSON).
# ATLAS_DATA_USE_POLICY=
# Feed database (blank = var/feeds/atlas_feed.sqlite).
# ATLAS_FEED_DB=
# Founder capital track (paper): signed risk policy dir, state/audit/payments DBs.
# ATLAS_FOUNDER_CONFIG_DIR=
# ATLAS_STATE_DB=
# ATLAS_AUDIT_DB=
# ATLAS_PAYMENTS_DB=
