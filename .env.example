GEMINI_API_KEY=
ATLAS_GEMINI_MODEL=gemini-3.8-flash
ATLAS_GEMINI_DEEP_MODEL=gemini-4-argon
# paid is required. The free tier is marked as used to improve Google products.
ATLAS_GEMINI_TIER=paid
# Optional operator-reviewed market-data use evidence. Missing evidence blocks
# market-data ML and new retention; it does not manufacture a provider license.
# ATLAS_DATA_USE_POLICY=C:/path/to/private/data-use-policy.json

# --- Founder capital track (Lola port; docs/lola-port-plan.md). Paper only. Names only, no secrets here.
# Full broker/payments placeholders live in config/founder/.env.example.
# ATLAS_FOUNDER_CONFIG_DIR=config/founder   # signed risk_policy.yaml (2% daily-loss Safe stop)
# ATLAS_STATE_DB=var/state.db               # Safe stop + approval queue, shared with atlas-watchdog
# ATLAS_AUDIT_DB=var/audit.db               # hash-chained audit log
# ATLAS_PAYMENTS_DB=var/payments.db         # read-only balance view for /money

# --- ATLAS data feed (docs/data-feeds.md). Names only; every keyed provider is optional.
# ATLAS_FEED_DB=var/feeds/atlas_feed.sqlite
# ATLAS_EVIDENCE_SOURCE=feed
# ATLAS_BINANCE_REST_HOSTS=https://data-api.binance.vision,https://api.binance.com
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
# ALPACA_DATA_FEED=iex
# FRED_API_KEY=
# TIINGO_API_KEY=
# POLYGON_API_KEY=
# POLYGON_BASE_URL=https://api.massive.com
# FINNHUB_API_KEY=
# TWELVEDATA_API_KEY=
# ALPHAVANTAGE_API_KEY=
# DATABENTO_API_KEY=
# ATLAS_DATABENTO_DATASET=          # explicit opt-in: Databento usage is billed
# IBKR_CP_GATEWAY_URL=https://localhost:5000
# OANDA_API_TOKEN=
# OANDA_ENV=practice
# OANDA_ACCOUNT_ID=
# TRADIER_ACCESS_TOKEN=
# TRADIER_ENV=sandbox
# QUESTRADE_REFRESH_TOKEN=
