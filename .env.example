# Stock/ETF source: polygon (default, Massive Stocks Basic, free, https://massive.com/dashboard/signup) | alphavantage | questrade | alpaca.
# The others stay as automatic fallbacks. Set ATLAS_<NAME>_PLAN=paid if you pay for intraday. No key is set for you: each shows Needs verification until Verify passes.
# ATLAS_STOCK_PROVIDER=polygon
# =============================================================================
# ATLAS environment template. PAPER TRADING ONLY. Copy to .env (gitignored) and fill in locally.
# Never commit real values. Every key is optional: a missing key shows "not configured" and that
# integration stays off. After adding a key, restart the server, then run:
#     python scripts/check_integrations.py
# Guide: docs/setup/integrations.md
# =============================================================================

# --- Alpaca: paper trading + market data (free) ------------------------------
# Paper key ID from https://app.alpaca.markets (switch to the Paper account first).
# Canonical names are ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY. Alpaca's own spellings are also accepted (canonical wins):
# ALPACA_API_KEY, APCA_API_KEY_ID  and  ALPACA_SECRET_KEY, ALPACA_API_SECRET, APCA_API_SECRET_KEY.
# OPTIONAL. A FREE paper account is available to Canadian residents: https://app.alpaca.markets. Live trading accounts and paid data plans are not offered to Canadians, so ATLAS uses paper only.
ALPACA_API_KEY_ID=
# Paper secret key (shown once when you generate the key).
ALPACA_API_SECRET_KEY=
# Paper endpoint. Any other URL (incl. live api.alpaca.markets) is refused by ATLAS.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market data feed: iex (free) or sip (paid subscription).
ALPACA_DATA_FEED=iex
# not used (paid): ALPACA_DATA_FEED=sip  (Algo Trader Plus subscription)

# --- SEC EDGAR: fundamentals/filings (free, no key) ---------------------------
# Required User-Agent "AppName your-email@domain", e.g. ATLASResearch you@example.com
# FREE, no key: "Your Name you@example.com" (SEC fair-access policy)
ATLAS_SEC_USER_AGENT=

# --- FRED / ALFRED: macro series + vintages (free key) ------------------------
# https://fredaccount.stlouisfed.org/apikeys
# FREE https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Market data feeds (all optional) -----------------------------------------
# Massive (formerly Polygon.io), free tier 5 calls/min.
# FREE Basic tier (5/min, EOD) https://massive.com
POLYGON_API_KEY=
# Massive REST base URL.
POLYGON_BASE_URL=https://api.massive.com
# Same Massive key, used by the Massive adapter or optional Massive MCP server.
# FREE Basic tier https://massive.com
MASSIVE_API_KEY=
# Massive REST base URL alias.
MASSIVE_BASE_URL=https://api.massive.com
# Finnhub quotes/news/fundamentals, free tier.
# FREE 60/min https://finnhub.io/register
FINNHUB_API_KEY=
# Tiingo EOD + IEX intraday, free tier.
# FREE personal use https://www.tiingo.com
TIINGO_API_KEY=
# Twelve Data, free tier.
# FREE 800/day https://twelvedata.com/register
TWELVEDATA_API_KEY=
# Alpha Vantage, free tier (25 calls/day).
# FREE 25/day https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# Financial Modeling Prep fundamentals, free tier.
# FREE 250/day https://site.financialmodelingprep.com/register
FMP_API_KEY=
# EODHD TSX/TSXV end-of-day (paid; free plan 20 calls/day).
# not used (paid): EODHD_API_KEY=
# Databento tick data (PAID, billed per use).
# not used (paid): DATABENTO_API_KEY=
# Databento dataset, e.g. GLBX.MDP3. Explicit opt-in because usage is billed.
# not used (paid): ATLAS_DATABENTO_DATASET=
# OANDA FX data token (free practice account).
# FREE practice account https://www.oanda.com
OANDA_API_TOKEN=
# OANDA practice account ID.
OANDA_ACCOUNT_ID=
# practice only (live is refused).
OANDA_ENV=practice
# Questrade refresh token (single use, expires in 3 days).
QUESTRADE_REFRESH_TOKEN=
# Local IBKR Client Portal gateway URL, e.g. https://localhost:5000 (paper login).
# not used (paid): IBKR_CP_GATEWAY_URL=
# Optional Solana JSON-RPC & WebSocket endpoints for Pump.fun / PumpSwap indexing.
SOLANA_RPC_URL=
SOLANA_WS_URL=

# --- Alerts (free; OFF by default) --------------------------------------------
# Master switch. Nothing is sent unless this is true AND a channel is set.
ATLAS_ALERTS_ENABLED=false
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Telegram chat ID to post into.
TELEGRAM_CHAT_ID=
# Discord channel webhook URL.
DISCORD_WEBHOOK_URL=
# Slack incoming-webhook URL.
SLACK_WEBHOOK_URL=
# ntfy push alerts. The topic is the secret on public ntfy.sh (use a long random one) or self-host and set NTFY_URL (+ NTFY_TOKEN).
NTFY_URL=
# (blank = https://ntfy.sh)
NTFY_TOPIC=
NTFY_TOKEN=

# --- Ops monitoring (both are NO-OPS until set) --------------------------------
# Healthchecks.io dead-man ping: the core loop pings this each safety step; you are alerted when pings stop. Full ping URL.
HEALTHCHECKS_PING_URL=
# Minimum seconds between pings (default 60, minimum 10).
HEALTHCHECKS_INTERVAL_S=
# Sentry error reporting (Python processes only; needs `pip install sentry-sdk`). No PII, cookies or bodies are sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# --- External data MCP servers (OFF by default; read-only tools only) ---------
# Set to on to allow the external MCP clients.
ATLAS_EXTERNAL_MCP=
# TradingView MCP token.
TRADINGVIEW_TOKEN=
# QuantConnect API token.
QUANTCONNECT_API_TOKEN=

# --- AI assistants (optional, paid) -------------------------------------------
# Google Gemini API key.
GEMINI_API_KEY=
# Gemini model ids. Tier must be paid (the free tier is used to improve Google products).
ATLAS_GEMINI_MODEL=gemini-3.8-flash
ATLAS_GEMINI_DEEP_MODEL=gemini-4-argon
ATLAS_GEMINI_TIER=free
# Other assistant providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# --- Local paths / data use (optional, non-secret; uncomment to override) ----------------------------
# Operator-reviewed market-data use evidence (path to a private JSON).
# ATLAS_DATA_USE_POLICY=
# Feed database (blank = var/feeds/atlas_feed.sqlite).
# ATLAS_FEED_DB=
# Founder capital track (paper): signed risk policy dir, state/audit/payments DBs.
# ATLAS_FOUNDER_CONFIG_DIR=
# ATLAS_STATE_DB=
# ATLAS_AUDIT_DB=
# ATLAS_PAYMENTS_DB=

# --- Safety / runtime (merged from the former config/founder/.env.example) ---------
# Trading mode. ATLAS is paper only: live also needs LIVE_ENABLED=true AND risk policy autonomy, and the Alpaca
# adapter refuses live regardless. Leave these as they are.
TRADING_MODE=paper
LIVE_ENABLED=false
# dev | paper (labels the environment; not a live switch)
APP_ENV=dev
# Must match risk_policy.yaml base_currency (checked by the policy validator).
BASE_CURRENCY=CAD
TZ=America/Toronto
LOG_LEVEL=INFO
# Dead-man watchdog; must agree with risk_policy.yaml (validator checks).
WATCHDOG_HEARTBEAT_INTERVAL_S=5
WATCHDOG_MISSED_BEATS_TO_HALT=3
WATCHDOG_DEADMAN_TIMEOUT_S=60
# IBKR TWS/Gateway port. 4002 = paper gateway; 4001/7496 (live) are rejected by the validator.
IBKR_GATEWAY_PORT=4002

# --- Trading MCP server + local dashboard (secrets: generate random 32+ char tokens) -
# Legacy single token for the trading MCP server (placeholders are rejected).
MCP_AUTH_TOKEN=
# Path to the scoped MCP client token file (read / propose / kill). Default var/mcp_tokens.json.
# ATLAS_MCP_TOKENS=var/mcp_tokens.json
# Token for the local dashboard kill button.
DASHBOARD_TOKEN=
# DASHBOARD_PORT=8765
# Optional Postgres (only if you run the Postgres store). The validator checks the DB name matches POSTGRES_DB.
DATABASE_URL=postgresql+asyncpg://tradingbot:<change-me>@localhost:5432/tradingbot
POSTGRES_DB=tradingbot

# --- Local LLM / FinBERT (optional, off by default) -------------------------------
# ATLAS_LLM_ENABLED=false
# ATLAS_LLM_ENDPOINT=
# ATLAS_LLM_MODEL=
ATLAS_LLM_API_KEY=
# ATLAS_FINBERT_PATH=

# Data policy: free official sources only. Paid/unofficial providers are refused unless these are set.
# ATLAS_ALLOW_PAID_DATA=false
# ATLAS_ALLOW_UNOFFICIAL_DATA=false

# --- Accounts, connectors and billing (evo-11). Never commit real values. ---------
# Master key for envelope-encrypting per-user connector secrets. REQUIRED to store any secret (fail closed without it).
# Generate:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ATLAS_MASTER_KEY=
# After rotating, keep the old key here, run `python -m atlas.accounts.cli rewrap`, then remove it.
# ATLAS_MASTER_KEY_PREVIOUS=
# The only email that may become the owner on registration (or use `python -m atlas.accounts.cli create-owner EMAIL`).
ATLAS_OWNER_EMAIL=
# Registration mode: invite (default) | open | closed. invite = an admin-issued single-use code is required.
# Create one:  python -m atlas.accounts.cli create-invite [email]
# ATLAS_REGISTRATION=invite
# Sign-in requirement. Unset = automatic: ON for any public deployment (ATLAS_ENV=production, ATLAS_TRUSTED_PROXIES set, or a
# non-loopback ATLAS_PUBLIC_URL) and for any non-loopback client; OFF only for a bare localhost install. 1/0 forces it.
# ATLAS_REQUIRE_AUTH=
# Deployment hints (read from the environment only, never from the Host header).
# ATLAS_ENV=production
# Comma separated IPs/CIDRs of reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are trusted (rate limiter, HSTS).
# ATLAS_TRUSTED_PROXIES=
# Email verification (default ON for a public deployment, OFF for bare localhost). 1/0 forces it.
# ATLAS_REQUIRE_EMAIL_VERIFICATION=
# Mail backend: console (default, logs to the server console, sends NOTHING) | smtp | file | memory.
# ATLAS_MAIL_BACKEND=console
# ATLAS_SMTP_FROM=ATLAS <no-reply@example.com>
# ATLAS_SMTP_HOST=
# ATLAS_SMTP_PORT=587
# ATLAS_SMTP_USER=
# ATLAS_SMTP_PASSWORD=
# starttls (default) | ssl | none
# ATLAS_SMTP_SECURITY=starttls
# file backend writes one .eml per message here (dev / screenshots)
# ATLAS_MAIL_OUTBOX=
# Postgres URL for `python -m atlas.accounts.cli migrate-pg` (schema only: the runtime store is still SQLite).
# ATLAS_DATABASE_URL=
# ATLAS_ACCOUNTS_DB=var/accounts/atlas_accounts.sqlite
# ATLAS_SESSION_IDLE_SECONDS=43200
# ATLAS_SESSION_ABS_SECONDS=604800
# Set when serving over https so the session cookie is Secure.
# ATLAS_COOKIE_SECURE=false
# ATLAS_PUBLIC_URL=http://localhost:3000
# Stripe TEST MODE only (sk_test_ / whsec_ from the Stripe test dashboard). Live keys are refused. No commissions are ever taken.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Tax hook (off by default): 1 adds automatic_tax + address/tax-id collection at checkout
ATLAS_STRIPE_TAX=
ATLAS_STRIPE_TAX_CODE=
# Assumed fee booked to the ledger per dispute (minor units)
ATLAS_DISPUTE_FEE_CENTS=1500
